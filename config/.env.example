# ============================================================================
# TRE OS v12.0 — ENVIRONMENT & CREDENTIALS TEMPLATE (.env)
# Copy to .env (chmod 600 .env) or generate via: python3 scripts/configure_run.py
# NEVER commit your real .env file to Git!
# ============================================================================

# 1. OKX EEA Spot API Credentials (Read + Trade permissions ONLY, zero withdrawal)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_SIMULATED_DEMO=0

# 2. Free AI Council Providers (100% $0.00 Free Tier)
# Primary: Google AI Studio Free Tier (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Secondary Failover: OpenRouter Free Tier (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# 3. Optional Telegram Executive Reporter
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 4. Optional Run Calibration Overrides (or configure in config/purified_run_config.json)
# Set RUN_EXPIRY_ISO=NONE for perpetual run, or ISO-8601 UTC e.g. 2026-12-31T21:00:00Z
RUN_EXPIRY_ISO=NONE
CASHOUT_TAPER_DAYS=6.0
